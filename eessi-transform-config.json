      "Template": "{doc}-{major}.{minor}.Designer",
      "Priority": 0
    },
    {
      "Pattern": "(?<doc>[A-Z]+[0-9]+[A-Z]*)-(?<major>\\d+)\\.(?<minor>\\d+)",
      "Template": "{doc}-{major}.{minor}.Designer",
      "Priority": 1
    }
  ],
  "DefaultNamespaceStrategy": "AutoGenerate",
  "DefaultOutputFilenameStrategy": "UseNamespace"
