				<ccts:BusinessProcessContextValue>EESSI</ccts:BusinessProcessContextValue>
				<ccts:OfficialConstraintContextValue>
					<CodeListEntry>
						<ccts:UniqueID>9BEE97CF-A349-E611-80CA-000D3A22E8CD</ccts:UniqueID>
						<value>01</value>
						<definition>Contestation accepted – the individual claim is totally withdrawn</definition>
					</CodeListEntry>
					<CodeListEntry>
						<ccts:UniqueID>9CEE97CF-A349-E611-80CA-000D3A22E8CD</ccts:UniqueID>
						<value>02</value>
						<definition>Contestation accepted – updated benefits and amounts must be provided</definition>
					</CodeListEntry>
					<CodeListEntry>
						<ccts:UniqueID>8A9F20DC-A349-E611-80CA-000D3A22E8CD</ccts:UniqueID>
						<value>03</value>
						<definition>Contestation after deadline, received on [date should be filled in]</definition>
					</CodeListEntry>
					<CodeListEntry>
						<ccts:UniqueID>8B9F20DC-A349-E611-80CA-000D3A22E8CD</ccts:UniqueID>
						<value>04</value>
						<definition>Information requested updated</definition>
					</CodeListEntry>
					<CodeListEntry>
						<ccts:UniqueID>BC9FD4E3-A349-E611-80CA-000D3A22E8CD</ccts:UniqueID>
						<value>05</value>
						<definition>After checking, no double invoice found</definition>
					</CodeListEntry>
					<CodeListEntry>
						<ccts:UniqueID>27FB87EA-A349-E611-80CA-000D3A22E8CD</ccts:UniqueID>
						<value>06</value>
						<definition>The primary entitlement in state of residence starts on [date should be filled in]</definition>
					</CodeListEntry>
					<CodeListEntry>
						<ccts:UniqueID>28FB87EA-A349-E611-80CA-000D3A22E8CD</ccts:UniqueID>
						<value>07</value>
						<definition>The family member is not entitled in the state of residence</definition>
					</CodeListEntry>
					<CodeListEntry>
						<ccts:UniqueID>E41265F3-A349-E611-80CA-000D3A22E8CD</ccts:UniqueID>
						<value>08</value>
						<definition>The costs are not to be settled by lump sum</definition>
					</CodeListEntry>
					<CodeListEntry>
						<ccts:UniqueID>E51265F3-A349-E611-80CA-000D3A22E8CD</ccts:UniqueID>
						<value>09</value>
						<definition>The family member is now registered on the entitlement document</definition>
					</CodeListEntry>
					<CodeListEntry>
						<ccts:UniqueID>1B8CA5FA-A349-E611-80CA-000D3A22E8CD</ccts:UniqueID>
						<value>10</value>
						<definition>According to the attached documents the invoice has to be paid</definition>
					</CodeListEntry>
					<CodeListEntry>
						<ccts:UniqueID>1C8CA5FA-A349-E611-80CA-000D3A22E8CD</ccts:UniqueID>
						<value>11</value>
						<definition>Enclosed you find the entitlement document</definition>
					</CodeListEntry>
					<CodeListEntry>
						<ccts:UniqueID>0A4E8002-A449-E611-80CA-000D3A22E8CD</ccts:UniqueID>
						<value>12</value>
						<definition>Enclosed you find the requested documents</definition>
					</CodeListEntry>
					<CodeListEntry>
						<ccts:UniqueID>F6EFBC17-06F5-E611-80D3-000D3A22E8CD</ccts:UniqueID>
						<value>99</value>
						<definition>Other</definition>
					</CodeListEntry>
				</ccts:OfficialConstraintContextValue>
			</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<xsd:element name='value' minOccurs='1' maxOccurs='1'>
				<xsd:simpleType>
					<xsd:restriction base='xsd:string'>
						<xsd:pattern value='(01|02|03|04|05|06|07|08|09|10|11|12|99){1}'/>
					</xsd:restriction>
				</xsd:simpleType>
			</xsd:element>
		</xsd:sequence>
