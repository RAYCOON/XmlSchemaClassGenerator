	<xsd:complexType name='SicknessContestationReplyCodeType'>
		<xsd:annotation>
			<xsd:documentation xml:lang="en">
				<ccts:UniqueID>0E367DC4-A349-E611-80CA-000D3A22E8CD</ccts:UniqueID>
